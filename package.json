{
  "name": "johannes-kroll",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "firebase:login": "npx --yes firebase-tools@15.30.0 login",
    "hosting:check": "npm run build && npx --yes firebase-tools@15.30.0 emulators:exec --only hosting --project demo-personal-website \"node scripts/check-hosting.mjs\"",
    "deploy": "npx --yes firebase-tools@15.30.0 deploy --only hosting --project personal-website-472f2"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^6.0.3"
  }
}
