---
import Layout from '../layouts/Layout.astro';
---

<Layout title="A little off the beaten path — Johannes Kroll" noindex>
  <main id="main" class="prose-page wrap">
    <span id="top" class="eyebrow">
      404 / AN UNPLANNED DETOUR
    </span>
    <h1>
      Curiosity brought
      <br />
      you a little <span class="serif-word">too far.</span>
    </h1>
    <p>
      There’s no page here, but there are a few good things back home. Including a small game or
      two.
    </p>
    <a class="button button-dark" href="/">
      Take me home <span aria-hidden="true">↗</span>
    </a>
  </main>
</Layout>
