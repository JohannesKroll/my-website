---
import '../styles/fonts.css';
import '../styles/global.css';
import sansFont from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import { defaultTitle, defaultDescription, profileStructuredData, siteName } from '../data/seo';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  profilePage?: boolean;
}
const {
  title = defaultTitle,
  description = defaultDescription,
  noindex = false,
  profilePage = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f1eb" />
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/social.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Johannes Kroll — AI & Data Scientist. Websites, software and agentic AI."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:image:alt"
      content="Johannes Kroll — AI & Data Scientist. Websites, software and agentic AI."
    />
    {profilePage && Astro.site && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(profileStructuredData(Astro.site, title, description)).replace(
          /</g,
          '\\u003c',
        )}
      ></script>
    )}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header wrap">
      <a href="/" class="wordmark" aria-label="JK / — Johannes Kroll home">
        JK <span class="wordmark-dot">/</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="/#play">Play</a>
        <a class="nav-contact" href="/#contact">
          Contact
        </a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer wrap">
      <a href="/" class="footer-name">
        Johannes Kroll
      </a>
      <span class="footer-note">Software. Sport. Source code.</span>
      <div class="footer-links">
        <a href="/site-info/">Site info</a>
        <a href="/privacy/">Privacy</a>
        <a href="#top" aria-label="Back to top">
          ↑
        </a>
      </div>
    </footer>
  </body>
</html>
